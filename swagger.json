  "definitions": {
    "CategoryInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Electronics"
        },
        "slug": {
          "type": "string",
          "example": "electronics"
        },
        "description": {
          "type": "string",
          "example": "Tech hardware and gadgets"
        },
        "isActive": {
          "type": "boolean",
          "example": true
        }
      }
    },
    "ProductInput": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "example": "Wireless Mouse"
        },
        "sku": {
          "type": "string",
          "example": "MOUSE-101"
        },
        "category": {
          "type": "string",
          "example": "66f2a1b3c4e5f67890123456"
        },
        "price": {
          "type": "number",
          "example": 29.99
        },
        "stockQuantity": {
          "type": "number",
          "example": 50
        },
        "inStock": {
          "type": "boolean",
          "example": true
        },
        "description": {
          "type": "string",
          "example": "Ergonomic wireless mouse"
        },
        "tags": {
          "type": "array",
          "example": [
            "computer",
            "accessories"
          ],
          "items": {
